// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "bindings": {
      "f10": "collab::Mute",
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "[ d": "editor::GoToPreviousDiagnostic",
      "] d": "editor::GoToDiagnostic",
      "g r a": "editor::ToggleCodeActions",
      "space b d": "pane::CloseActiveItem",
      "space d a": "agent::ToggleFocus",
      "space d d": "diagnostics::Deploy",
      "space e": "project_panel::ToggleFocus",
      "space f g": "workspace::NewSearch",
      "space f f": "file_finder::Toggle",
      "space l a": "editor::ToggleCodeActions",
      "space l f": "editor::Format",
      "space t a": "agent::ToggleFocus",
      "space t h": "workspace::ToggleLeftDock",
      "space t j": "workspace::ToggleBottomDock",
      "space t l": "workspace::ToggleRightDock",
      "space t m": "multi_workspace::ToggleWorkspaceSidebar",
      "space t p": "multi_workspace::ToggleWorkspaceSidebar",
      "space t t": "terminal_panel::Toggle",
    },
  },
  {
    "context": "vim_mode == insert || vim_mode == visual",
    "bindings": {
      "ctrl-d": "editor::SelectNext",
    },
  },
]
