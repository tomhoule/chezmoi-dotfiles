[user]
    name = Tom Houlé
    email = tom@tomhoule.com
    signingkey = {{ .chezmoi.homeDir }}/.ssh/id_ed25519.pub
[alias]
    br = branch
    ca = commit --amend
    co = checkout
    fa = fetch --all
    pf = push --force
    pso = push --set-upstream origin
    rc = rebase --continue
    s = status -s
[apply]
    whitespace = fix
[core]
    whitespace = trailing-space,space-before-tab,indent-with-non-tab
[pull]
    rebase = true
[push]
    autoSetupRemote = true
[init]
    defaultBranch = main
[merge]
    conflictStyle = zdiff3
[gpg]
	format = ssh
[commit]
    verbose = true
[rebase]
    updateRefs = true
[rerere]
    enabled = true
