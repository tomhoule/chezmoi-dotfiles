[user]
    name = Tom Houlé
    email = tom@tomhoule.com
    signingKey = "~/.ssh/main.pub"
[gpg]
    format = ssh
[gpg "ssh"]
	program = "{{ .chezmoi.homeDir }}/.local/bin/ssh-keygen-tpm"
	allowedSignersFile = "~/.ssh/allowed_signers"
[alias]
    br = branch
    ca = commit --amend
    co = checkout
    fa = fetch --all
    pf = push --force
    pso = push --set-upstream origin
    rc = rebase --continue
    s = status -s
[apply]
    whitespace = fix
[core]
    whitespace = trailing-space,space-before-tab,indent-with-non-tab
[pull]
    rebase = true
[push]
    autoSetupRemote = true
[init]
    defaultBranch = main
[merge]
    conflictStyle = zdiff3
[gpg]
	format = ssh
[commit]
    verbose = true
    gpgsign = true
[rebase]
    updateRefs = true
[rerere]
    enabled = true
[url "git@github.com:"]
	insteadOf = https://github.com/
